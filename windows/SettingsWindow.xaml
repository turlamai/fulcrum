<Window
    x:Class="RivetHost.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Shared six-section IA across macOS/Windows/Linux (design/DESIGN.md);
         native WinUI 3 NavigationView + card controls preserve the Windows
         interaction model. Settings and commands are still owned and
         validated by RVT1. Every chrome string is painted from shared/i18n
         by ApplyLocalization; the XAML text below is the English fallback. -->
    <Grid>
        <Grid.Resources>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16,4,16,4" />
            </Style>
            <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="0,18,0,6" />
            </Style>
            <Style x:Key="RowLabel" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,0,16,0" />
            </Style>
            <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Opacity" Value="0.7" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,0,0,10" />
            </Style>
            <Style x:Key="Row" TargetType="Grid">
                <Setter Property="MinHeight" Value="52" />
            </Style>
        </Grid.Resources>

        <NavigationView x:Name="SettingsNavigation" PaneDisplayMode="Left"
                        OpenPaneLength="176"
                        IsPaneToggleButtonVisible="False" IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False" IsPaneOpen="True"
                        SelectionChanged="Navigation_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="NavGeneral" Content="General" Tag="general" AutomationProperties.AutomationId="settings-sidebar-general" />
                <NavigationViewItem x:Name="NavFeatures" Content="Features" Tag="features" AutomationProperties.AutomationId="settings-sidebar-features" />
                <NavigationViewItem x:Name="NavAi" Content="AI" Tag="ai" AutomationProperties.AutomationId="settings-sidebar-ai" />
                <NavigationViewItem x:Name="NavCommands" Content="Commands" Tag="commands" AutomationProperties.AutomationId="settings-sidebar-commands" />
                <NavigationViewItem x:Name="NavWorkflows" Content="Workflows" Tag="workflows" AutomationProperties.AutomationId="settings-sidebar-workflows" />
                <NavigationViewItem x:Name="NavSync" Content="Sync &amp; Updates" Tag="sync" AutomationProperties.AutomationId="settings-sidebar-sync" />
            </NavigationView.MenuItems>
            <ScrollViewer>
                <StackPanel Margin="24,4,24,24" HorizontalAlignment="Stretch">

                <StackPanel x:Name="GeneralSection" Visibility="Visible" AutomationProperties.AutomationId="settings-general-content">
                <TextBlock x:Name="GeneralTitle" Text="General" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="LanguageLabel" Text="Language" Style="{StaticResource RowLabel}" />
                            <ComboBox x:Name="LanguageBox" Grid.Column="1" Tag="language" MinWidth="160"
                                      VerticalAlignment="Center" SelectionChanged="Choice_Changed">
                                <ComboBoxItem x:Name="LangSystemItem" Content="System" Tag="system" />
                                <ComboBoxItem x:Name="LangEnItem" Content="English" Tag="en" />
                                <ComboBoxItem x:Name="LangZhItem" Content="中文" Tag="zh" />
                            </ComboBox>
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ThemeLabel" Text="Theme" Style="{StaticResource RowLabel}" />
                            <ComboBox x:Name="ThemeBox" Grid.Column="1" Tag="theme" MinWidth="160"
                                      VerticalAlignment="Center" SelectionChanged="Choice_Changed">
                                <ComboBoxItem x:Name="ThemeSystemItem" Content="System" Tag="system" />
                                <ComboBoxItem x:Name="ThemeLightItem" Content="Light" Tag="light" />
                                <ComboBoxItem x:Name="ThemeDarkItem" Content="Dark" Tag="dark" />
                            </ComboBox>
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="StartAtLoginLabel" Text="Start at login" Style="{StaticResource RowLabel}" />
                            <ToggleSwitch x:Name="LoginStartupSwitch" Grid.Column="1" Tag="local-login-startup"
                                          AutomationProperties.AutomationId="FulcrumStartAtLogin"
                                          OnContent="" OffContent="" MinWidth="0"
                                          VerticalAlignment="Center" Toggled="Toggle_Toggled" />
                        </Grid>
                        <TextBlock x:Name="StartAtLoginHint" Style="{StaticResource Hint}"
                                   Text="Starts quietly after login. This device only; not synced." />
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="HotkeyLabel" Text="Hotkey" Style="{StaticResource RowLabel}" />
                            <TextBox x:Name="HotkeyBox" Grid.Column="1" Tag="hotkey" MinWidth="200"
                                     AutomationProperties.AutomationId="settings-record-hotkey"
                                     VerticalAlignment="Center" PlaceholderText="Focus and press a shortcut"
                                     IsReadOnly="True" KeyDown="Hotkey_KeyDown" />
                        </Grid>
                        <TextBlock x:Name="HotkeyHint" Style="{StaticResource Hint}"
                                   Text="Focus and press modifiers plus a key; it applies immediately. Esc cancels. If another app owns the combo, Fulcrum falls back to Ctrl+Alt+Space." />
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="MaxResultsLabel" Text="Maximum results" Style="{StaticResource RowLabel}" />
                            <NumberBox x:Name="MaxResultsBox" Grid.Column="1" Tag="max-results"
                                       Minimum="5" Maximum="12" SpinButtonPlacementMode="Inline"
                                       VerticalAlignment="Center" ValueChanged="Number_Changed" />
                        </Grid>
                        <TextBlock x:Name="MaxResultsHint" Style="{StaticResource Hint}"
                                   Text="Rows shown before the list scrolls; range 5–12." />
                    </StackPanel>
                </Border>

                </StackPanel>

                <StackPanel x:Name="FeaturesSection" Visibility="Collapsed">
                <TextBlock x:Name="FeaturesTitle" Text="Features" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ClipboardLabel" Text="Clipboard history" Style="{StaticResource RowLabel}" />
                            <ToggleSwitch x:Name="ClipboardSwitch" Grid.Column="1" Tag="clipboard-enabled"
                                          OnContent="" OffContent="" MinWidth="0"
                                          VerticalAlignment="Center" Toggled="Toggle_Toggled" />
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ClipboardLimitLabel" Text="Clipboard history limit" Style="{StaticResource RowLabel}" />
                            <NumberBox x:Name="ClipboardLimitBox" Grid.Column="1" Tag="clipboard-limit"
                                       Minimum="10" Maximum="100000" MinWidth="160"
                                       VerticalAlignment="Center" ValueChanged="Number_Changed" />
                        </Grid>
                        <TextBlock x:Name="ClipboardLimitHint" Style="{StaticResource Hint}"
                                   Text="Entries kept on this device; range 10–100000." />
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="WebSearchLabel" Text="Web search" Style="{StaticResource RowLabel}" />
                            <ToggleSwitch x:Name="WebSearchSwitch" Grid.Column="1" Tag="web-search-enabled"
                                          OnContent="" OffContent="" MinWidth="0"
                                          VerticalAlignment="Center" Toggled="Toggle_Toggled" />
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="DefaultBangLabel" Text="Default bang" Style="{StaticResource RowLabel}" />
                            <ComboBox x:Name="DefaultBangBox" Grid.Column="1" Tag="default-engine" MinWidth="160"
                                      VerticalAlignment="Center" SelectionChanged="Choice_Changed">
                                <ComboBoxItem Content="!g" Tag="!g" />
                                <ComboBoxItem Content="!d" Tag="!d" />
                                <ComboBoxItem Content="!gh" Tag="!gh" />
                                <ComboBoxItem Content="!so" Tag="!so" />
                                <ComboBoxItem Content="!w" Tag="!w" />
                                <ComboBoxItem Content="!yt" Tag="!yt" />
                                <ComboBoxItem Content="!m" Tag="!m" />
                                <ComboBoxItem Content="!t" Tag="!t" />
                            </ComboBox>
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ExpansionLabel" Text="Snippet expansion" Style="{StaticResource RowLabel}" />
                            <ToggleSwitch x:Name="ExpansionSwitch" Grid.Column="1" Tag="expansion-enabled"
                                          OnContent="" OffContent="" MinWidth="0"
                                          VerticalAlignment="Center" Toggled="Toggle_Toggled" />
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="PluginsLabel" Text="Plugins" Style="{StaticResource RowLabel}" />
                            <ToggleSwitch x:Name="PluginsSwitch" Grid.Column="1" Tag="plugins-enabled"
                                          OnContent="" OffContent="" MinWidth="0"
                                          VerticalAlignment="Center" Toggled="Toggle_Toggled" />
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="PluginTimeoutLabel" Text="Plugin call timeout (ms)" Style="{StaticResource RowLabel}" />
                            <NumberBox x:Name="PluginTimeoutBox" Grid.Column="1" Tag="plugins-timeout-ms"
                                       Minimum="100" Maximum="10000" MinWidth="160"
                                       VerticalAlignment="Center" ValueChanged="Number_Changed" />
                        </Grid>
                        <TextBlock x:Name="PluginTimeoutHint" Style="{StaticResource Hint}"
                                   Text="Per-call plugin process timeout; range 100–10000 ms." />
                    </StackPanel>
                </Border>

                </StackPanel>

                <StackPanel x:Name="AiSection" Visibility="Collapsed">
                <TextBlock x:Name="AiTitle" Text="AI" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ProviderLabel" Text="AI provider" Style="{StaticResource RowLabel}" />
                            <ComboBox x:Name="ProviderBox" Grid.Column="1" Tag="ai-provider" MinWidth="160"
                                      VerticalAlignment="Center" SelectionChanged="Choice_Changed">
                                <ComboBoxItem x:Name="ProviderOffItem" Content="Off" Tag="" />
                                <ComboBoxItem Content="OpenAI" Tag="openai" />
                                <ComboBoxItem Content="Anthropic" Tag="anthropic" />
                                <ComboBoxItem Content="Ollama" Tag="ollama" />
                            </ComboBox>
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ModelLabel" Text="Model" Style="{StaticResource RowLabel}" />
                            <TextBox x:Name="ModelBox" Grid.Column="1" Tag="ai-model" MinWidth="240"
                                     VerticalAlignment="Center" PlaceholderText="provider default"
                                     LostFocus="Text_LostFocus" KeyDown="Text_KeyDown" />
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="BaseUrlLabel" Text="Base URL" Style="{StaticResource RowLabel}" />
                            <TextBox x:Name="BaseUrlBox" Grid.Column="1" Tag="ai-base-url" MinWidth="240"
                                     VerticalAlignment="Center" PlaceholderText="provider default"
                                     LostFocus="Text_LostFocus" KeyDown="Text_KeyDown" />
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="PersonaLabel" Text="Persona" Style="{StaticResource RowLabel}" />
                            <TextBox x:Name="PersonaBox" Grid.Column="1" Tag="ai-persona" MinWidth="240"
                                     VerticalAlignment="Center" PlaceholderText="prepended to every request"
                                     LostFocus="Text_LostFocus" KeyDown="Text_KeyDown" />
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ApiKeyLabel" Text="API key" Style="{StaticResource RowLabel}" />
                            <PasswordBox x:Name="KeyBox" Grid.Column="1" MinWidth="240" VerticalAlignment="Center"
                                         PlaceholderText="paste a key" KeyDown="Key_KeyDown" />
                            <Button x:Name="SaveKeyButton" Grid.Column="2" Content="Save" Margin="8,0,0,0"
                                    VerticalAlignment="Center" Click="SaveKey_Click" />
                        </Grid>
                        <TextBlock x:Name="AiStatusText" Style="{StaticResource Hint}" Text="" />
                        <TextBlock x:Name="KeyNotice" Style="{StaticResource Hint}" Text="" />
                        <TextBlock x:Name="AiKeysHint" Style="{StaticResource Hint}"
                                   Text="Stored in ai-keys.json on this device; never mirrored to the sync folder." />
                    </StackPanel>
                </Border>

                </StackPanel>

                <StackPanel x:Name="CommandsSection" Visibility="Collapsed" AutomationProperties.AutomationId="settings-commands-content">
                    <TextBlock x:Name="CommandsTitle" Text="Commands" Style="{StaticResource SectionTitle}"
                               AutomationProperties.AutomationId="settings-commands-title" />
                    <TextBlock x:Name="CommandsHint" Style="{StaticResource Hint}"
                               Text="Give a command your own shorthand (it ranks like a name) and a global hotkey that runs it with the panel hidden." />
                    <TextBlock x:Name="BindingErrorText" Foreground="#D13438" TextWrapping="Wrap" Visibility="Collapsed" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel x:Name="CommandRows" Spacing="6">
                            <TextBlock x:Name="CommandsLoadingText" Text="Loading command bindings…" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Native Workflow editor: all operations use the existing
                     search/run-action RVT1 API. No local workflow interpreter. -->
                <StackPanel x:Name="WorkflowsSection" Visibility="Collapsed"
                            AutomationProperties.AutomationId="workflow-editor">
                    <TextBlock x:Name="WorkflowsTitle" Text="Workflows" Style="{StaticResource SectionTitle}" />
                    <TextBlock x:Name="WorkflowsHint" Style="{StaticResource Hint}"
                               Text="Local-only steps; the shared backend validates every change. Debug traces never expose input or output." />
                    <Border Style="{StaticResource Card}">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBox x:Name="WorkflowNameBox" PlaceholderText="new-name"
                                         Width="160" AutomationProperties.AutomationId="workflow-create-name" />
                                <Button x:Name="WorkflowCreateButton" Content="Create" Click="WorkflowCreate_Click"
                                        AutomationProperties.AutomationId="workflow-create" />
                                <Button x:Name="WorkflowRefreshButton" Content="Refresh" Click="WorkflowRefresh_Click"
                                        AutomationProperties.AutomationId="workflow-refresh" />
                            </StackPanel>
                            <StackPanel x:Name="WorkflowListRows" Spacing="4">
                                <TextBlock x:Name="WorkflowListLoadingText" Text="Loading workflows…" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="WorkflowListPrevButton" Content="Previous" Click="WorkflowPrevious_Click"
                                        AutomationProperties.AutomationId="workflow-list-previous" />
                                <TextBlock x:Name="WorkflowListPage" Text="Page 1" VerticalAlignment="Center" />
                                <Button x:Name="WorkflowListNextButton" Content="Next" Click="WorkflowNext_Click"
                                        AutomationProperties.AutomationId="workflow-list-next" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="WorkflowSelectedText" Text="Select a workflow"
                               FontWeight="SemiBold" Margin="0,12,0,6" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel Spacing="8">
                            <StackPanel x:Name="WorkflowStepRows" Spacing="6" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="WorkflowStepPrevButton" Content="Previous" Click="WorkflowStepPrevious_Click" />
                                <TextBlock x:Name="WorkflowStepPage" Text="Steps page 1" VerticalAlignment="Center" />
                                <Button x:Name="WorkflowStepNextButton" Content="Next" Click="WorkflowStepNext_Click" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBox x:Name="WorkflowStepBox" Width="300"
                                         PlaceholderText="trim, lines unique, require text…"
                                         AutomationProperties.AutomationId="workflow-step-expression" />
                                <Button x:Name="WorkflowAddStepButton" Content="Add step" Click="WorkflowAdd_Click"
                                        AutomationProperties.AutomationId="workflow-add-step" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="WorkflowInputLabel" Text="Input (multiple lines supported)" Margin="0,12,0,4" FontWeight="SemiBold" />
                    <TextBox x:Name="WorkflowInputBox" AcceptsReturn="True" TextWrapping="Wrap"
                             Height="74" PlaceholderText="@clipboard to use recent local clipboard text"
                             AutomationProperties.AutomationId="workflow-input" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,8">
                        <Button x:Name="WorkflowDryRunButton" Content="Dry run" Click="WorkflowDry_Click"
                                AutomationProperties.AutomationId="workflow-dry-run" />
                        <Button x:Name="WorkflowRunCopyButton" Content="Run to clipboard"
                                IsEnabled="False" Click="WorkflowRun_Click"
                                AutomationProperties.AutomationId="workflow-run-copy" />
                        <CheckBox x:Name="WorkflowDeleteConfirm" Content="Confirm delete" />
                        <Button x:Name="WorkflowDeleteButton" Content="Delete" Click="WorkflowDelete_Click"
                                AutomationProperties.AutomationId="workflow-delete" />
                    </StackPanel>
                    <TextBlock x:Name="WorkflowClipboardNote" Style="{StaticResource Hint}"
                               Text="@clipboard explicitly reads recent local text. Paste workflows must run from the launcher to preserve focus." />
                    <Border Style="{StaticResource Card}">
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="WorkflowTraceTitle" Text="Redacted debug trace" FontWeight="SemiBold" />
                            <StackPanel x:Name="WorkflowTraceRows" Spacing="5" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="WorkflowTracePrevButton" Content="Previous" Click="WorkflowTracePrevious_Click" />
                                <TextBlock x:Name="WorkflowTracePage" Text="Trace page 1" VerticalAlignment="Center" />
                                <Button x:Name="WorkflowTraceNextButton" Content="Next" Click="WorkflowTraceNext_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="WorkflowStatusText" Style="{StaticResource Hint}"
                               Text="Workflow actions remain local and user-initiated."
                               AutomationProperties.AutomationId="workflow-status"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel x:Name="SyncSection" Visibility="Collapsed">
                <TextBlock x:Name="SyncTitle" Text="Sync &amp; Updates" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="SyncFolderLabel" Text="Sync folder (beta)" Style="{StaticResource RowLabel}" />
                            <TextBox x:Name="SyncRootBox" Grid.Column="1" Tag="sync-root" MinWidth="280"
                                     VerticalAlignment="Center" PlaceholderText="empty = off"
                                     LostFocus="Text_LostFocus" KeyDown="Text_KeyDown" />
                        </Grid>
                        <TextBlock x:Name="SyncFolderHint" Style="{StaticResource Hint}"
                                   Text="A folder a file sync service replicates (OneDrive, Dropbox, Syncthing); settings and snippets mirror there." />
                        <!-- Updates parity (design/DESIGN.md): the Sync page is the
                             automatic-check note plus one button that opens the
                             dedicated update window — the same surface the tray
                             and the launcher update rows open on every host. -->
                        <TextBlock x:Name="UpdatesNoteHint" Style="{StaticResource Hint}"
                                   Text="Fulcrum checks signed releases automatically. Use Check for Updates from the tray menu or the button below." />
                        <Button x:Name="CheckUpdatesNowButton" Content="Check for Updates Now"
                                AutomationProperties.AutomationId="settings-update-check"
                                Click="CheckUpdatesNow_Click" Margin="0,0,0,12" />
                    </StackPanel>
                </Border>

                </StackPanel>

                <TextBlock x:Name="ErrorText" Margin="0,16,0,0" Foreground="#D13438"
                           TextWrapping="Wrap" IsTextSelectionEnabled="True" Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>
        </NavigationView>
    </Grid>
</Window>